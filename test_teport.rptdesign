            <xml-property name="queryText"><![CDATA[select
person.person_name  as nama ,
person.gender as kelamin,
person.birth_place as TempatLahir,
person.birth_dttm as TanggalLahir,
person_address.person_address_text as alamat,
person_contact.phone as phone,
person_contact.email as email

from person
join person_address ON person_address.person_id = person.person_id
join person_contact ON person_contact.person_id = person.person_id
 ]]></xml-property>
