                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
	oh.dpjp_id,
	isi.ivf_site_logo_url as logo_url,
	p.patient_mrn as patient_mrn,
	DATE_FORMAT(p2.birth_dttm, '%d-%m-%Y') as tgl_lahir,
	p2.person_name as person_name
FROM order_header oh
left join organization o on oh.organization_id = o.organization_id
LEFT JOIN location l ON o.organization_id = l.organization_id 
LEFT JOIN ivf_site isi ON o.organization_id = isi.organization_id
LEFT JOIN patient p ON p.patient_id = oh.patient_id 
LEFT JOIN person p2 ON p2.person_id = p.patient_id 
where oh.order_header_id = ?
limit 1]]></xml-property>
