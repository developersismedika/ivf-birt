                </structure>
                <structure>
                    <property name="position">215</property>
                    <property name="name">jumlah_total</property>
                    <property name="nativeName">jumlah_total</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">216</property>
                    <property name="name">total_motilitas</property>
                    <property name="nativeName">total_motilitas</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">217</property>
                    <property name="name">total_hidup_ejakulasi</property>
                    <property name="nativeName">total_hidup_ejakulasi</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">218</property>
                    <property name="name">checked_by_list</property>
                    <property name="nativeName">checked_by_list</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
*,
(volume * concentrate) as jumlah_total,
(motilitas_progresif_cepat + motilitas_progresif_lambat + motilitas_non_progresif) as total_motilitas,
((motilitas_progresif_cepat + motilitas_progresif_lambat + motilitas_non_progresif) * (volume * concentrate)) as total_hidup_ejakulasi,
GROUP_CONCAT(sac.practitioner_id) AS checked_by_list 
from sperm_analysis sa 
LEFT JOIN order_header oh ON sa.order_header_id = oh.order_header_id
LEFT JOIN organization o ON oh.organization_id = o.organization_id 
LEFT JOIN location l ON o.organization_id = l.organization_id 
LEFT JOIN ivf_site isi ON o.organization_id = isi.organization_id
LEFT JOIN patient p ON oh.patient_id = p.patient_id 
LEFT JOIN person p2 ON p.patient_id = p2.person_id 
LEFT JOIN  person_contact pc ON p2.person_id = pc.person_id 
LEFT JOIN sperm_analysis_checker sac ON sa.sperm_analysis_id = sac.sperm_analysis_id
WHERE sa.order_header_id = ?;]]></xml-property>
