            <xml-property name="queryText"><![CDATA[SELECT 
    oh.order_header_id,
    oh.order_type,
    oh.patient_id,
    oh.patient_couple_number,
    p_single.patient_id AS single_patient_id,
    person_single.person_name AS single_patient_name,
    DATE_FORMAT(person_single.birth_dttm, '%d-%m-%Y') AS single_birth_date,
    pc.patient_couple_male_id AS couple_male_id,
    person_male.person_name AS couple_male_name,
    DATE_FORMAT(person_male.birth_dttm, '%d-%m-%Y') AS single_birth_date_male,
    pc.patient_couple_female_id AS couple_female_id,
    person_female.person_name AS couple_female_name,
    DATE_FORMAT(person_female.birth_dttm, '%d-%m-%Y') AS single_birth_date_female
FROM order_header oh
-- Jika Single: Langsung ke Patients &amp; Person
LEFT JOIN patient p_single ON oh.patient_id = p_single.patient_id
LEFT JOIN person person_single ON p_single.patient_id = person_single.person_id
-- Jika Couple: Cek ke patient_couple
LEFT JOIN patient_couple pc ON oh.patient_couple_number = pc.patient_cn
LEFT JOIN patient p_male ON pc.patient_couple_male_id = p_male.patient_id
LEFT JOIN person person_male ON p_male.patient_id = person_male.person_id
LEFT JOIN patient p_female ON pc.patient_couple_female_id = p_female.patient_id
LEFT JOIN person person_female ON p_female.patient_id = person_female.person_id
WHERE oh.order_header_id = ?;]]></xml-property>
