                                            <property name="dataType">integer</property>
                                        </structure>
                                    </list-property>
                                    <expression name="valueExpr">((row["motilitas_progresif_cepat"] + row["motilitas_progresif_lambat"] + row["motilitas_non_progresif"]) * (row["volume"] * row["concentrate"]) / 100)</expression>
