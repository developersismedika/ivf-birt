            <xml-property name="queryText"><![CDATA[SELECT 
	sa.person_mrn,
	sa.freezing_date,
	sa.practitioner_name,
	sa.sample_type,
	sa.time_out,
	sa.time_analysis,
	sa.volume,
	sa.color_sample,
	sa.viskositas,
	sa.concentrate,
	sa.motilitas_progresif,
	sa.motilitas_non_progresif,
	sa.motilitas_imotil,
	sa.is_debris,
	sa.debris,
	sa.infeksius,
	sa.report_code
FROM freezing_sperm sa 
LEFT JOIN order_header oh ON sa.order_header_id = oh.order_header_id
WHERE sa.order_header_id = ?;]]></xml-property>
