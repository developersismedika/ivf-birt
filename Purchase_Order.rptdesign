            <xml-property name="queryText"><![CDATA[SELECT 
pi2.purchase_order_inventory_id,
i.inventory_name,
iu.item_unit_name,
i.inventory_code,
pi2.total,
pi2.price,
pi2.discount_amount,
pi2.price_discounted,
pi2.total * ic.value_conversion as total_item,
pi2.discount_type as discount_type
FROM purchase_order_inventories pi2 
LEFT JOIN inventory i ON i.inventory_id = pi2.inventory_id 
LEFT JOIN item_unit iu ON iu.item_unit_id = pi2.unit_inventory_id 
LEFT JOIN inventory_conversions ic ON ic.inventory_id = pi2.inventory_id AND ic.unit_from_id = pi2.unit_inventory_id 
WHERE pi2.purchase_order_id = ?]]></xml-property>
