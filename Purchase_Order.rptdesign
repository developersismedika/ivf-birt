            <xml-property name="queryText"><![CDATA[SELECT 
	o.organization_name,
	l.address_line1 ,
	l.address_line2 ,
	isi.ivf_site_logo_url 
FROM purchase_orders p 
LEFT JOIN organization o ON p.organization_id = o.organization_id 
LEFT JOIN location l ON o.organization_id = l.organization_id 
LEFT JOIN ivf_site isi ON o.organization_id = isi.organization_id
WHERE p.purchase_order_id = ?]]></xml-property>
