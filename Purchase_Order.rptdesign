    <method name="initialize"><![CDATA[
/**
 * Expose angkaTerbilang as a global function for use in expressions.
 * Works across generation and render phases.
 */
function angkaTerbilang(n) {
    n = Math.floor(Number(n) || 0);
    if (n === 0) return "Nol Rupiah";
    var satuan = ["", "Satu", "Dua", "Tiga", "Empat", "Lima", "Enam", "Tujuh", "Delapan", "Sembilan"];
    var tingkat = ["", "Ribu", "Juta", "Milyar", "Triliun"];
    function tigaDigit(x) {
        var ratus = Math.floor(x / 100);
        var sisa = x % 100;
        var hasil = "";
        if (ratus > 0) hasil += (ratus == 1 ? "Seratus" : satuan[ratus] + " Ratus") + " ";
        if (sisa > 0) {
            if (sisa < 10) hasil += satuan[sisa];
            else if (sisa < 20) {
                var belasan = ["Sepuluh","Sebelas","Dua Belas","Tiga Belas","Empat Belas","Lima Belas","Enam Belas","Tujuh Belas","Delapan Belas","Sembilan Belas"];
                hasil += belasan[sisa - 10];
            } else {
                var puluh = Math.floor(sisa / 10);
                var sisaSatuan = sisa % 10;
                hasil += (puluh == 1 ? "Sepuluh" : satuan[puluh] + " Puluh");
                if (sisaSatuan > 0) hasil += " " + satuan[sisaSatuan];
            }
        }
        return hasil.trim();
    }
    var i = 0, hasil = "";
    while (n > 0) {
        var bagian = n % 1000;
        if (bagian > 0) {
            var segmen = tigaDigit(bagian);
            if (i === 1 &amp;&amp; bagian === 1) segmen = "Seribu";
            hasil = segmen + " " + tingkat[i] + " " + hasil;
        }
        n = Math.floor(n / 1000);
        i++;
    }
    return hasil.trim() + " Rupiah";
}
reportContext.setPersistentGlobalVariable("angkaTerbilang", angkaTerbilang);
// Also assign into global scope so bare calls may work in some contexts
this.angkaTerbilang = angkaTerbilang;
]]></method>
    <method name="beforeFactory"><![CDATA[function angkaTerbilang(n) {
    var satuan = ["", "Satu", "Dua", "Tiga", "Empat", "Lima", "Enam", "Tujuh", "Delapan", "Sembilan"];
    var tingkat = ["", "Ribu", "Juta", "Milyar", "Triliun"];
    
    function tigaDigit(n) {
        var ratus = Math.floor(n / 100);
        var sisa = n % 100;
        var hasil = "";
        
        if (ratus > 0) {
            hasil += (ratus == 1 ? "Seratus" : satuan[ratus] + " Ratus") + " ";
        }
        
        if (sisa > 0) {
            if (sisa < 10) {
                hasil += satuan[sisa];
            } else if (sisa < 20) {
                var belasan = ["Sepuluh", "Sebelas", "Dua Belas", "Tiga Belas", "Empat Belas", "Lima Belas", "Enam Belas", "Tujuh Belas", "Delapan Belas", "Sembilan Belas"];
                hasil += belasan[sisa - 10];
            } else {
                var puluhan = Math.floor(sisa / 10);
                hasil += satuan[puluhan] + " Puluh " + satuan[sisa % 10];
            }
        }

        return hasil.trim();
    }

    if (n === 0) return "Nol";

    var hasil = "";
    var i = 0;

    while (n > 0) {
        var bagian = n % 1000;
        if (bagian > 0) {
            var segmen = tigaDigit(bagian);
            if (i === 1 &amp;&amp; bagian === 1) {
                segmen = "Seribu";
            }
            hasil = segmen + " " + tingkat[i] + " " + hasil;
        }
        n = Math.floor(n / 1000);
        i++;
    }

    return hasil.trim() + " Rupiah";
}

function formatRupiah(angka) {
    return Number(angka).toLocaleString("id-ID", {minimumFractionDigits: 0});
}
]]></method>
    <method name="beforeRender"><![CDATA[function angkaTerbilang(n) {
    var satuan = ["", "Satu", "Dua", "Tiga", "Empat", "Lima", "Enam", "Tujuh", "Delapan", "Sembilan"];
    var tingkat = ["", "Ribu", "Juta", "Milyar", "Triliun"];
    
    function tigaDigit(n) {
        var ratus = Math.floor(n / 100);
        var sisa = n % 100;
        var hasil = "";
        
        if (ratus > 0) {
            hasil += (ratus == 1 ? "Seratus" : satuan[ratus] + " Ratus") + " ";
        }
        
        if (sisa > 0) {
            if (sisa < 10) {
                hasil += satuan[sisa];
            } else if (sisa < 20) {
                var belasan = ["Sepuluh", "Sebelas", "Dua Belas", "Tiga Belas", "Empat Belas", "Lima Belas", "Enam Belas", "Tujuh Belas", "Delapan Belas", "Sembilan Belas"];
                hasil += belasan[sisa - 10];
            } else {
                var puluhan = Math.floor(sisa / 10);
                hasil += satuan[puluhan] + " Puluh " + satuan[sisa % 10];
            }
        }

        return hasil.trim();
    }

    if (n === 0) return "Nol";

    var hasil = "";
    var i = 0;

    while (n > 0) {
        var bagian = n % 1000;
        if (bagian > 0) {
            var segmen = tigaDigit(bagian);
            if (i === 1 &amp;&amp; bagian === 1) {
                segmen = "Seribu";
            }
            hasil = segmen + " " + tingkat[i] + " " + hasil;
        }
        n = Math.floor(n / 1000);
        i++;
    }

    return hasil.trim() + " Rupiah";
}

function formatRupiah(angka) {
    return Number(angka).toLocaleString("id-ID", {minimumFractionDigits: 0});
}
]]></method>
