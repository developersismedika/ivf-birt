            <xml-property name="queryText"><![CDATA[SELECT 
    ivf_site.ivf_site_name,
    eo.order_header_id,
    eo.order_header_number,
    eo.total,
    eo.type,
    eo.patient_id,
    per.person_name AS patient_name,
    p.patient_mrn, 
    p.patient_referal_code, 
    p.patient_socialmedia_code, 
    p.patient_referal_note,
    CASE 
        WHEN NOT EXISTS (
            SELECT 1
            FROM order_header oh_prev
            WHERE (
                (eo.type = 'single' AND oh_prev.patient_id = eo.patient_id AND oh_prev.patient_couple_number = '')
                OR
                (eo.type LIKE 'couple-%' AND oh_prev.patient_couple_number = eo.patient_couple_number AND eo.patient_couple_number IS NOT NULL)
            )
            AND oh_prev.order_header_date < eo.order_header_date
        )
        THEN 'Yes'
        ELSE 'No'
    END AS is_first_transaction
FROM (
    -- Single patients
    SELECT 
        oh.order_header_id,
        oh.order_header_number,
        oh.total,
        oh.patient_id,
        oh.organization_id,
        NULL AS patient_couple_number,
        'single' AS type,
        oh.order_header_date
    FROM order_header oh
    WHERE oh.patient_couple_number = ''
      AND oh.order_header_date BETWEEN ? AND ?
      AND oh.organization_id != ?

    UNION ALL

    -- Couple (male)
    SELECT 
        oh.order_header_id,
        oh.order_header_number,
        oh.total,
        pc.patient_couple_male_id AS patient_id,
        oh.organization_id,
        oh.patient_couple_number,
        'couple-male' AS type,
        oh.order_header_date
    FROM order_header oh
    LEFT JOIN patient_couple pc ON pc.patient_cn = oh.patient_couple_number
    WHERE oh.patient_couple_number != ''
      AND oh.order_header_date BETWEEN ? AND ?
      AND oh.organization_id != ?

    UNION ALL

    -- Couple (female)
    SELECT 
        oh.order_header_id,
        oh.order_header_number,
        oh.total,
        pc.patient_couple_female_id AS patient_id,
        oh.organization_id,
        oh.patient_couple_number,
        'couple-female' AS type,
        oh.order_header_date
    FROM order_header oh
    LEFT JOIN patient_couple pc ON pc.patient_cn = oh.patient_couple_number
    WHERE oh.patient_couple_number != ''
      AND oh.order_header_date BETWEEN ? AND ?
      AND oh.organization_id != ?
) eo
JOIN patient p ON eo.patient_id = p.patient_id
JOIN person per ON p.patient_id = per.person_id
JOIN ivf_site ON ivf_site.organization_id = eo.organization_id
ORDER BY is_first_transaction DESC, eo.order_header_date;
]]></xml-property>
