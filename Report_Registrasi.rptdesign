            <xml-property name="queryText"><![CDATA[SELECT
  oh.order_header_number AS no_reg,
  DATE(oh.order_header_date) AS tgl_visit,
CASE
    
    WHEN oh.order_type = 'single' THEN
    oh.patient_id ELSE ( SELECT CONCAT( pc.patient_couple_male_id, '/', pc.patient_couple_female_id ) FROM patient_couple pc WHERE pc.patient_cn = oh.patient_couple_number LIMIT 1 ) 
  END AS patient__id,
CASE
    
    WHEN oh.order_type = 'single' THEN
    pn.person_name ELSE (
    SELECT
      CONCAT(
        ( SELECT pn1.person_name FROM person pn1 WHERE pn1.person_id = pc.patient_couple_male_id LIMIT 1 ),
        '/',
        ( SELECT pn1.person_name FROM person pn1 WHERE pn1.person_id = pc.patient_couple_female_id LIMIT 1 ) 
      ) 
    FROM
      patient_couple pc 
    WHERE
      pc.patient_cn = oh.patient_couple_number 
      LIMIT 1 
    ) 
  END AS nama_pasien,
  pt.patient_referal_code AS referral,
CASE
    
    WHEN (
    SELECT
      COUNT(*) 
    FROM
      order_header oh_1 
    WHERE
    CASE
        
        WHEN oh_1.order_type = 'single' THEN
        oh_1.patient_id ELSE ( SELECT CONCAT( pc.patient_couple_male_id, '/', pc.patient_couple_female_id ) FROM patient_couple pc WHERE pc.patient_cn = oh_1.patient_couple_number LIMIT 1 ) 
      END =
    CASE
        
        WHEN oh.order_type = 'single' THEN
        oh.patient_id ELSE ( SELECT CONCAT( pc.patient_couple_male_id, '/', pc.patient_couple_female_id ) FROM patient_couple pc WHERE pc.patient_cn = oh.patient_couple_number LIMIT 1 ) 
      END 
        ) > 1 THEN
        'Pasien Lama' ELSE 'Pasien Baru' 
      END AS jenis_pasien 
    FROM
      order_header oh
      LEFT JOIN patient pt ON pt.patient_id = oh.patient_id
      LEFT JOIN person pn ON pn.person_id = pt.patient_id 
    WHERE
      oh.order_header_date >= ? 
      AND oh.order_header_date <= ?
      AND oh.organization_id = ?
      AND (
    ? = 0 -- Parameter `patient_type` = 0, include all patients
    OR ( ? = 1 AND
         CASE
           WHEN (
             SELECT COUNT(*)
             FROM order_header oh_1
             WHERE
               CASE
                 WHEN oh_1.order_type = 'single' THEN
                   oh_1.patient_id
                 ELSE 
                   (SELECT CONCAT(pc.patient_couple_male_id, '/', pc.patient_couple_female_id)
                    FROM patient_couple pc
                    WHERE pc.patient_cn = oh_1.patient_couple_number
                    LIMIT 1)
               END =
               CASE
                 WHEN oh.order_type = 'single' THEN
                   oh.patient_id
                 ELSE 
                   (SELECT CONCAT(pc.patient_couple_male_id, '/', pc.patient_couple_female_id)
                    FROM patient_couple pc
                    WHERE pc.patient_cn = oh.patient_couple_number
                    LIMIT 1)
               END
           ) = 1 THEN 'Pasien Baru' ELSE 'Pasien Lama'
         END = 'Pasien Baru'
       )
    OR ( ? = 2 AND
         CASE
           WHEN (
             SELECT COUNT(*)
             FROM order_header oh_1
             WHERE
               CASE
                 WHEN oh_1.order_type = 'single' THEN
                   oh_1.patient_id
                 ELSE 
                   (SELECT CONCAT(pc.patient_couple_male_id, '/', pc.patient_couple_female_id)
                    FROM patient_couple pc
                    WHERE pc.patient_cn = oh_1.patient_couple_number
                    LIMIT 1)
               END =
               CASE
                 WHEN oh.order_type = 'single' THEN
                   oh.patient_id
                 ELSE 
                   (SELECT CONCAT(pc.patient_couple_male_id, '/', pc.patient_couple_female_id)
                    FROM patient_couple pc
                    WHERE pc.patient_cn = oh.patient_couple_number
                    LIMIT 1)
               END
           ) > 1 THEN 'Pasien Lama' ELSE 'Pasien Baru'
         END = 'Pasien Lama'
       )
  ) 
    GROUP BY
      oh.order_header_id,
      pt.patient_mrn,
    pn.person_name,
  pt.patient_referal_code;]]></xml-property>
