                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">-5</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
  jenis_pasien,
  COUNT(DISTINCT patient__id) AS jumlah_pasien
FROM (
  SELECT 
    CASE
      WHEN (
        SELECT COUNT(*)
        FROM order_header oh_1
        WHERE 
          CASE
            WHEN oh_1.order_type = 'single' THEN oh_1.patient_id
            ELSE (
              SELECT CONCAT(pc.patient_couple_male_id, '/', pc.patient_couple_female_id)
              FROM patient_couple pc
              WHERE pc.patient_cn = oh_1.patient_couple_number
              LIMIT 1
            )
          END = 
          CASE
            WHEN oh.order_type = 'single' THEN oh.patient_id
            ELSE (
              SELECT CONCAT(pc.patient_couple_male_id, '/', pc.patient_couple_female_id)
              FROM patient_couple pc
              WHERE pc.patient_cn = oh.patient_couple_number
              LIMIT 1
            )
          END
      ) > 1 
      THEN 'Jumlah Pasien Lama'
      ELSE 'Jumlah Pasien Baru'
    END AS jenis_pasien,
    CASE
      WHEN oh.order_type = 'single' THEN oh.patient_id
      ELSE (
        SELECT CONCAT(pc.patient_couple_male_id, '/', pc.patient_couple_female_id)
        FROM patient_couple pc
        WHERE pc.patient_cn = oh.patient_couple_number
        LIMIT 1
      )
    END AS patient__id
  FROM
    order_header oh
  LEFT JOIN patient pt ON pt.patient_id = oh.patient_id
  LEFT JOIN person pn ON pn.person_id = pt.patient_id 
  WHERE
    oh.order_header_date >= ? 
    AND oh.order_header_date <= ?
    AND oh.organization_id = ?
    AND (
    ? = 0 -- Parameter `patient_type` = 0, include all patients
    OR ( ? = 1 AND
         CASE
           WHEN (
             SELECT COUNT(*)
             FROM order_header oh_1
             WHERE
               CASE
                 WHEN oh_1.order_type = 'single' THEN
                   oh_1.patient_id
                 ELSE 
                   (SELECT CONCAT(pc.patient_couple_male_id, '/', pc.patient_couple_female_id)
                    FROM patient_couple pc
                    WHERE pc.patient_cn = oh_1.patient_couple_number
                    LIMIT 1)
               END =
               CASE
                 WHEN oh.order_type = 'single' THEN
                   oh.patient_id
                 ELSE 
                   (SELECT CONCAT(pc.patient_couple_male_id, '/', pc.patient_couple_female_id)
                    FROM patient_couple pc
                    WHERE pc.patient_cn = oh.patient_couple_number
                    LIMIT 1)
               END
           ) = 1 THEN 'Pasien Baru' ELSE 'Pasien Lama'
         END = 'Pasien Baru'
       )
    OR ( ? = 2 AND
         CASE
           WHEN (
             SELECT COUNT(*)
             FROM order_header oh_1
             WHERE
               CASE
                 WHEN oh_1.order_type = 'single' THEN
                   oh_1.patient_id
                 ELSE 
                   (SELECT CONCAT(pc.patient_couple_male_id, '/', pc.patient_couple_female_id)
                    FROM patient_couple pc
                    WHERE pc.patient_cn = oh_1.patient_couple_number
                    LIMIT 1)
               END =
               CASE
                 WHEN oh.order_type = 'single' THEN
                   oh.patient_id
                 ELSE 
                   (SELECT CONCAT(pc.patient_couple_male_id, '/', pc.patient_couple_female_id)
                    FROM patient_couple pc
                    WHERE pc.patient_cn = oh.patient_couple_number
                    LIMIT 1)
               END
           ) > 1 THEN 'Pasien Lama' ELSE 'Pasien Baru'
         END = 'Pasien Lama'
       )
  ) 
  GROUP BY
    oh.order_header_id
) AS classified_data
GROUP BY jenis_pasien;]]></xml-property>
