            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">total_kunjungan</property>
                    <property name="nativeName">total_kunjungan</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">-5</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">patient_type_label</property>
                    <property name="nativeName">patient_type_label</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
  COUNT(*) AS total_kunjungan,
  CASE
    WHEN ? = 0 THEN 'All Patients'
    WHEN ? = 1 THEN 'Pasien Baru'
    WHEN ? = 2 THEN 'Pasien Lama'
  END AS patient_type_label
FROM (
  SELECT
    oh.order_header_number AS no_reg,
    CASE
      WHEN (
        SELECT COUNT(*)
        FROM order_header oh_1
        WHERE
          CASE
            WHEN oh_1.order_type = 'single' THEN oh_1.patient_id
            ELSE (
              SELECT CONCAT(pc.patient_couple_male_id, '/', pc.patient_couple_female_id)
              FROM patient_couple pc
              WHERE pc.patient_cn = oh_1.patient_couple_number
              LIMIT 1
            )
          END =
          CASE
            WHEN oh.order_type = 'single' THEN oh.patient_id
            ELSE (
              SELECT CONCAT(pc.patient_couple_male_id, '/', pc.patient_couple_female_id)
              FROM patient_couple pc
              WHERE pc.patient_cn = oh.patient_couple_number
              LIMIT 1
            )
          END
      ) > 1 THEN 'Pasien Lama'
      ELSE 'Pasien Baru'
    END AS jenis_pasien
  FROM
    order_header oh
  WHERE
    oh.order_header_date >= ?
    AND oh.order_header_date <= ?
    AND oh.organization_id = ?
) AS repeated_records
WHERE
  ? = 0 -- Include all data if patient_type = 0
  OR (? = 1 AND jenis_pasien = 'Pasien Baru') -- Filter for "Pasien Baru" if patient_type = 1
  OR (? = 2 AND jenis_pasien = 'Pasien Lama'); -- Filter for "Pasien Lama" if patient_type = 2
]]></xml-property>
