            <xml-property name="queryText"><![CDATA[SELECT 
	oh.dpjp_id,
	p.account_name,
	p_male.person_name as male_name,
	DATE_FORMAT(p_male.birth_dttm, '%d-%m-%Y') as tgl_lahir_male,
	pat_male.patient_mrn as patient_mrn_male,
	p_female.person_name as female_name,
	DATE_FORMAT(p_female.birth_dttm, '%d-%m-%Y') as tgl_lahir_female,
	pat_female.patient_mrn as patient_mrn_female,
	isi.ivf_site_logo_url as logo_url
FROM order_header oh 
LEFT JOIN practitioner p ON p.practitioner_id = oh.dpjp_id 
LEFT JOIN patient_couple pc ON pc.patient_cn = oh.patient_couple_number
left join patient pat_male on pat_male.patient_id = pc.patient_couple_male_id 
LEFT JOIN person p_male on p_male.person_id = pat_male.patient_id
LEFT JOIN patient pat_female on pat_female.patient_id = pc.patient_couple_female_id 
LEFT JOIn person p_female on p_female.person_id = pat_female.patient_id
left join organization o on oh.organization_id = o.organization_id
LEFT JOIN location l ON o.organization_id = l.organization_id 
LEFT JOIN ivf_site isi ON o.organization_id = isi.organization_id
where oh.order_header_id = ?
limit 1]]></xml-property>
