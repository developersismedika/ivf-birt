            <property name="dataSource">Data Source</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">header_id</property>
                    <property name="nativeName">header_id</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">-5</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">stage_type</property>
                    <property name="nativeName">stage_type</property>
                    <property name="dataType">integer</property>
                    <property name="nativeDataType">-6</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">stage_desc</property>
                    <property name="nativeName">stage_desc</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">date</property>
                    <property name="nativeName">date</property>
                    <property name="dataType">date-time</property>
                    <property name="nativeDataType">93</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">time</property>
                    <property name="nativeName">time</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">ceser</property>
                    <property name="nativeName">ceser</property>
                    <property name="dataType">integer</property>
                    <property name="nativeDataType">4</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">checker</property>
                    <property name="nativeName">checker</property>
                    <property name="dataType">integer</property>
                    <property name="nativeDataType">4</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">remarks</property>
                    <property name="nativeName">remarks</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[WITH ranked_wo AS (
  SELECT 
    wo.work_order_id,
    wo.emr_id,
    wo.stimulant_item_id,
    ROW_NUMBER() OVER (
      ORDER BY wo.work_order_number ASC
    ) AS cycle_number
  FROM work_order wo
  JOIN emr e              ON wo.emr_id = e.emr_id
  JOIN encounter enc      ON e.encounter_id = enc.encounter_id
  JOIN order_header oh    ON enc.order_header_id = oh.order_header_id
  LEFT JOIN patient_couple pc  ON oh.patient_couple_number = pc.patient_cn
  LEFT JOIN person fmprs ON pc.patient_couple_female_id = fmprs.person_id
  LEFT JOIN patient fmpt ON fmprs.person_id             = fmpt.patient_id
  LEFT JOIN patient pa   ON e.patient_id = pa.patient_id
  WHERE ((oh.order_type = 'couple' AND fmpt.patient_id = ?) OR
         (oh.order_type <> 'couple' AND pa.patient_id   = ?))
    AND wo.stage_type = 0
),
selected_cycles AS (
  SELECT work_order_id
  FROM ranked_wo
  WHERE cycle_number = ? 
),
selected_procedures AS (
  SELECT ep.embryology_procedure_id
  FROM embryology_procedure ep
  JOIN work_order wo 
    ON ep.emr_id = wo.emr_id AND ep.stimulant_item_id = wo.stimulant_item_id
  WHERE wo.work_order_id IN (SELECT work_order_id FROM selected_cycles)
),
cycle_stage_headers AS (
  SELECT
    h.embryology_ivf_cycle_stage_header_id AS header_id,
    h.stage_type,
    h.date    AS date,
    h.time    AS time,
    h.ceser_id   AS ceser,
    h.checker_id AS checker,
    h.remarks
  FROM embryology_ivf_cycle_stage_header h
  JOIN selected_procedures sp 
    ON h.embryology_procedure_id = sp.embryology_procedure_id
  WHERE h.stage_type = 9 
)
SELECT
  header_id,
  stage_type,
  CASE stage_type
    WHEN 0 THEN 'DAY OPU'
    ELSE 'Unknown'
  END AS stage_desc,
  date,
  time,
  ceser,
  checker,
  remarks
FROM cycle_stage_headers
LIMIT 1;
]]></xml-property>
        </oda-data-set>
