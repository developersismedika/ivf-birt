  WHERE ((oh.order_type = 'couple' AND fmpt.patient_id = ?) OR
         (oh.order_type <> 'couple' AND pa.patient_id   = ?))
    AND wo.stage_type = 0
),
selected_cycles AS (
  SELECT work_order_id
  FROM ranked_wo
  WHERE cycle_number = ? 
),
selected_procedures AS (
  SELECT ep.embryology_procedure_id
  FROM embryology_procedure ep
  JOIN work_order wo 
    ON ep.emr_id = wo.emr_id AND ep.stimulant_item_id = wo.stimulant_item_id
  WHERE wo.work_order_id IN (SELECT work_order_id FROM selected_cycles)
),
cycle_stage_headers AS (
  SELECT
    h.embryology_ivf_cycle_stage_header_id AS header_id,
    h.stage_type,
    h.date    AS date,
    h.time    AS time,
    ceser.person_name   AS ceser,
    checker.person_name AS checker,
    h.remarks
  FROM embryology_ivf_cycle_stage_header h
  JOIN selected_procedures sp 
    ON h.embryology_procedure_id = sp.embryology_procedure_id
  LEFT JOIN person ceser ON h.ceser_id = ceser.person_id
  LEFT JOIN person checker ON h.checker_id = checker.person_id
  WHERE h.stage_type = 4 
)
SELECT
  header_id,
  stage_type,
  CASE stage_type
    WHEN 0 THEN 'DAY OPU'
    ELSE 'Unknown'
  END AS stage_desc,
  date,
  DATE_FORMAT(time, '%H:%i') AS time,
  ceser,
  checker,
  remarks
FROM cycle_stage_headers
LIMIT 1;
]]></xml-property>
        </oda-data-set>
