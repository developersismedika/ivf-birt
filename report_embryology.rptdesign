            <xml-property name="queryText"><![CDATA[WITH base_samples AS (
    SELECT
        ness.embryology_ivf_cycle_stage_samples_id AS sample_id,
        ness.embryology_ivf_cycle_stage_header_id,
        ness.no                                   AS sample_no,
        ness.is_external,    -- Kolom untuk logic sample_no
        ness.day,
        ness.cycle,
        ness.straw_no,
        ness.survival,
        ness.bank_id,
        ness.pot_id,
        ness.cassette_id,
        ness.result,
        ness.note,
        ness.status_action,
        ness.freezing_dttm,
        ness.thawing_dttm,
        ness.thawing_time,
        ness.thawing_ceser_id,
        ness.thawing_checker_id,
        ness.ceser_id,
        ness.checker_id,
        ness.culture_observation_dttm,
        ness.culture_observation_time,
        ness.culture_observation_embryo_quality,
        ness.culture_observation_ceser_id,
        ness.culture_observation_checker_id,
        ness.fet_dttm,
        ness.fet_time,
        ness.fet_transfer_quality,
        ness.fet_embryo_quality,
        ness.programme
    FROM embryology_ivf_cycle_stage_samples ness
    JOIN embryology_ivf_cycle_stage_header sh 
        ON ness.embryology_ivf_cycle_stage_header_id = sh.embryology_ivf_cycle_stage_header_id
    JOIN embryology_procedure ep 
        ON sh.embryology_procedure_id = ep.embryology_procedure_id
    JOIN emr e 
        ON ep.emr_id = e.emr_id
    JOIN encounter enc 
        ON e.encounter_id = enc.encounter_id
    JOIN order_header oh 
        ON enc.order_header_id = oh.order_header_id
    LEFT JOIN patient_couple pc  
        ON oh.patient_couple_number = pc.patient_cn
    LEFT JOIN person fmprs 
        ON pc.patient_couple_female_id = fmprs.person_id
    LEFT JOIN patient fmpt 
        ON fmprs.person_id = fmpt.patient_id
    LEFT JOIN patient pa   
        ON e.patient_id = pa.patient_id
    WHERE ((oh.order_type = 'couple' AND fmpt.patient_id = ?) OR
           (oh.order_type <> 'couple' AND oh.patient_id   = ?))
      AND sh.stage_type = 12
      AND ness.nullified_dttm IS NULL
      AND (ness.fet_dttm IS NULL OR DATE(ness.fet_dttm) BETWEEN ? AND ?)
),
thawing_photos AS (
  SELECT
    ph.embryology_ivf_cycle_stage_samples_id AS sample_id,
    CONCAT(
      '<center>',
        GROUP_CONCAT(
          CONCAT(
            '<img src="', ph.file_path, 
            '" style="max-width:100%;height:auto;margin:2px;" />'
          )
          ORDER BY ph.embryology_ivf_cycle_stage_samples_photo_id
          SEPARATOR ''
        ),
      '</center>'
    ) AS thawing_photos
  FROM embryology_ivf_cycle_stage_samples_photo ph
  WHERE ph.category = 'ThawingPhotos'
    AND ph.nullified_dttm IS NULL
  GROUP BY ph.embryology_ivf_cycle_stage_samples_id
),
culture_observation_photos AS (
  SELECT
    ph.embryology_ivf_cycle_stage_samples_id AS sample_id,
    CONCAT(
      '<center>',
        GROUP_CONCAT(
          CONCAT(
            '<img src="', ph.file_path, 
            '" style="max-width:100%;height:auto;margin:2px;" />'
          )
          ORDER BY ph.embryology_ivf_cycle_stage_samples_photo_id
          SEPARATOR ''
        ),
      '</center>'
    ) AS culture_observation_photos
  FROM embryology_ivf_cycle_stage_samples_photo ph
  WHERE ph.category = 'CultureObservationPhotos'
    AND ph.nullified_dttm IS NULL
  GROUP BY ph.embryology_ivf_cycle_stage_samples_id
)
SELECT
  -- SAMPLE NO: external > null > 0 > 01-09 > >=10
  CONCAT(
    '<center>',
    CASE
      WHEN bs.is_external = 'Y' THEN ''
      WHEN bs.sample_no IS NULL THEN ''
      WHEN bs.sample_no = 0 THEN ''
      WHEN bs.sample_no BETWEEN 1 AND 9 THEN LPAD(bs.sample_no, 2, '0')
      ELSE CAST(bs.sample_no AS CHAR)
    END,
    '</center>'
  ) AS sample_no,

  -- STORAGE DETAILS
  CONCAT('<span style="color:#454F5B;">Date:</span> ', IFNULL(DATE_FORMAT(bs.freezing_dttm, '%d/%b/%Y'), '-')) AS storage_date,
  CONCAT('<span style="color:#454F5B;">Cycle:</span> ', IFNULL(bs.cycle, '-')) AS storage_cycle,
  CONCAT('<span style="color:#454F5B;">Day:</span> ', IFNULL(bs.day, '-')) AS storage_day,
  CONCAT('<span style="color:#454F5B;">Bank:</span> ', IFNULL(sb.title, '-')) AS storage_bank,
  CONCAT('<span style="color:#454F5B;">Pot:</span> ', IFNULL(pm.title, '-')) AS storage_pot,
  CONCAT('<span style="color:#454F5B;">Cassette:</span> ', IFNULL(c.casset_name, '-')) AS storage_cassette,

  -- THAW DETAILS
  CONCAT('<span style="color:#454F5B;">Date:</span> ', IFNULL(DATE_FORMAT(bs.thawing_dttm, '%d/%b/%Y'), '-')) AS thaw_date,
  CONCAT('<span style="color:#454F5B;">Time:</span> ', IFNULL(DATE_FORMAT(DATE_ADD(STR_TO_DATE(bs.thawing_time, '%Y-%m-%dT%H:%i:%s'), INTERVAL 7 HOUR), '%H:%i'), '-')) AS thaw_time,
  CONCAT('<span style="color:#454F5B;">Straw No:</span> ', IFNULL(bs.straw_no, '-')) AS thaw_straw_no,
  CONCAT('<span style="color:#454F5B;">Survival:</span> ', IFNULL(CONCAT(bs.survival, '%'), '-')) AS thaw_survival,
  CONCAT('<span style="color:#454F5B;">Ceser:</span> ', IFNULL(thawing_ceser.person_name, '-')) AS thaw_ceser,
  CONCAT('<span style="color:#454F5B;">Checker:</span> ', IFNULL(thawing_checker.person_name, '-')) AS thaw_checker,
  COALESCE(tp.thawing_photos, '') AS thawing_photos,

  -- CULTURE OBSERVATION
  CONCAT('<span style="color:#454F5B;">Date:</span> ', IFNULL(DATE_FORMAT(bs.culture_observation_dttm, '%d/%b/%Y'), '-')) AS culture_date,
  CONCAT('<span style="color:#454F5B;">Time:</span> ', IFNULL(DATE_FORMAT(DATE_ADD(STR_TO_DATE(bs.culture_observation_time, '%Y-%m-%dT%H:%i:%s'), INTERVAL 7 HOUR), '%H:%i'), '-')) AS culture_time,
  CONCAT('<span style="color:#454F5B;">Embryo Quality:</span> ', IFNULL(bs.culture_observation_embryo_quality, '-')) AS culture_embryo_quality,
  CONCAT('<span style="color:#454F5B;">Ceser:</span> ', IFNULL(culture_ceser.person_name, '-')) AS culture_ceser,
  CONCAT('<span style="color:#454F5B;">Checker:</span> ', IFNULL(culture_checker.person_name, '-')) AS culture_checker,
  COALESCE(cp.culture_observation_photos, '') AS culture_observation_photos,

  -- EMBRYO TRANSFER
  CONCAT('<span style="color:#454F5B;">Date:</span> ', IFNULL(DATE_FORMAT(bs.fet_dttm, '%d/%b/%Y'), '-')) AS fet_date,
  CONCAT('<span style="color:#454F5B;">Time:</span> ', IFNULL(DATE_FORMAT(DATE_ADD(STR_TO_DATE(bs.fet_time, '%Y-%m-%dT%H:%i:%s'), INTERVAL 7 HOUR), '%H:%i'), '-')) AS fet_time,
  CONCAT('<span style="color:#454F5B;">Embryo Quality:</span> ', IFNULL(bs.fet_embryo_quality, '-')) AS fet_embryo_quality,
  CONCAT('<span style="color:#454F5B;">Transfer Quality:</span> ', IFNULL(bs.fet_transfer_quality, '-')) AS fet_transfer_quality,

  -- GENERAL/EXTRA
  CONCAT('<span style="color:#454F5B;">Result:</span> ', IFNULL(bs.result, '-')) AS result,
  CONCAT('<span style="color:#454F5B;">Note:</span> ', IFNULL(bs.note, '-')) AS note,
  CONCAT('<span style="color:#454F5B;">Status:</span> ', IFNULL(bs.status_action, '-')) AS status_action

FROM base_samples bs
LEFT JOIN bank_locations sb ON bs.bank_id = sb.bank_id
LEFT JOIN pots pm           ON bs.pot_id = pm.pot_id
LEFT JOIN pot_casset_pivots c ON bs.cassette_id = c.pot_casset_id
LEFT JOIN person ceser   ON bs.ceser_id   = ceser.person_id
LEFT JOIN person checker ON bs.checker_id = checker.person_id
LEFT JOIN person culture_ceser   ON bs.culture_observation_ceser_id      = culture_ceser.person_id
LEFT JOIN person culture_checker ON bs.culture_observation_checker_id = culture_checker.person_id
LEFT JOIN thawing_photos tp ON tp.sample_id = bs.sample_id
LEFT JOIN person thawing_ceser   ON bs.thawing_ceser_id   = thawing_ceser.person_id
LEFT JOIN person thawing_checker ON bs.thawing_checker_id = thawing_checker.person_id
LEFT JOIN culture_observation_photos cp ON cp.sample_id = bs.sample_id
ORDER BY bs.cycle, bs.sample_no;
]]></xml-property>
        </oda-data-set>
