                    <property name="nativeDataType">4</property>
                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">pb</property>
                    <property name="nativeName">pb</property>
                    <property name="dataType">integer</property>
                    <property name="nativeDataType">4</property>
                </structure>
                <structure>
                    <property name="position">11</property>
                    <property name="name">pn_label</property>
                    <property name="nativeName">pn_label</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">12</property>
                    <property name="name">pb_label</property>
                    <property name="nativeName">pb_label</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">13</property>
                    <property name="name">num_of_cells</property>
                    <property name="nativeName">num_of_cells</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">14</property>
                    <property name="name">frags_percentage</property>
                    <property name="nativeName">frags_percentage</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">3</property>
                </structure>
                <structure>
                    <property name="position">15</property>
                    <property name="name">quality_score</property>
                    <property name="nativeName">quality_score</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">16</property>
                    <property name="name">photo_file_paths</property>
                    <property name="nativeName">photo_file_paths</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[WITH ranked_wo AS (
  SELECT 
    wo.work_order_id,
    wo.emr_id,
    wo.stimulant_item_id,
    ROW_NUMBER() OVER (
      ORDER BY wo.work_order_number ASC
    ) AS cycle_number
  FROM work_order wo
  JOIN emr e              ON wo.emr_id = e.emr_id
  JOIN encounter enc      ON e.encounter_id = enc.encounter_id
  JOIN order_header oh    ON enc.order_header_id = oh.order_header_id
  LEFT JOIN patient_couple pc  ON oh.patient_couple_number = pc.patient_cn
  LEFT JOIN person fmprs ON pc.patient_couple_female_id = fmprs.person_id
  LEFT JOIN patient fmpt ON fmprs.person_id             = fmpt.patient_id
  LEFT JOIN patient pa   ON e.patient_id = pa.patient_id
  WHERE ((oh.order_type = 'couple' AND fmpt.patient_id = ?) OR
         (oh.order_type <> 'couple' AND pa.patient_id   = ?))
    AND wo.stage_type = 0
),
selected_cycles AS (
  SELECT work_order_id
  FROM ranked_wo
  WHERE cycle_number = ? -- 3: cycle_number
),
selected_procedures AS (
  SELECT ep.embryology_procedure_id
  FROM embryology_procedure ep
  JOIN work_order wo 
    ON ep.emr_id = wo.emr_id AND ep.stimulant_item_id = wo.stimulant_item_id
  WHERE wo.work_order_id IN (SELECT work_order_id FROM selected_cycles)
),
cycle_stage_headers AS (
  SELECT
    h.embryology_ivf_cycle_stage_header_id AS header_id
  FROM embryology_ivf_cycle_stage_header h
  JOIN selected_procedures sp 
    ON h.embryology_procedure_id = sp.embryology_procedure_id
  WHERE h.stage_type = 2
),
cycle_samples AS (
  SELECT 
    s.embryology_ivf_cycle_stage_samples_id AS sample_id,
    s.no                                    AS sample_no,
    s.sample_type,
    s.status,
    s.icsi_ivf_method                       AS method,
    s.note,
    s.pn,
    s.pb,
    s.num_of_cells,
    s.frags_percentage,
    s.quality_score
  FROM embryology_ivf_cycle_stage_samples s
  WHERE s.embryology_ivf_cycle_stage_header_id IN (
    SELECT header_id FROM cycle_stage_headers
  )
),
cycle_photos AS (
  SELECT
    ph.embryology_ivf_cycle_stage_samples_id AS sample_id,
    CONCAT(
      GROUP_CONCAT(
        CONCAT(
          '<img src="', ph.file_path, 
          '" style="display:inline-block;max-width:100%;height:auto;margin:2px;" />'
        )
        ORDER BY ph.embryology_ivf_cycle_stage_samples_photo_id
        SEPARATOR ''
      )
    ) AS photo_file_paths
  FROM embryology_ivf_cycle_stage_samples_photo ph
  WHERE ph.embryology_ivf_cycle_stage_samples_id IN (
    SELECT sample_id FROM cycle_samples
  )
  GROUP BY ph.embryology_ivf_cycle_stage_samples_id
)

SELECT
  cs.sample_id,
  cs.sample_no,
  CASE cs.sample_type
    WHEN 'Fresh' THEN
      '<span style="display:inline-block;background-color:#c4d4c4;border:1px solid #c4d4c4;border-radius:6px;padding:2px 4px;">Fresh</span>'
    WHEN 'Frozen' THEN
      '<span style="display:inline-block;background-color:#C4C9D9;border:1px solid #C4C9D9;border-radius:6px;padding:2px 4px;">Frozen</span>'
    ELSE cs.sample_type
  END AS sample_type,
  CASE 
    WHEN cs.status = 'ONE_PB'  THEN '1 PB'
    WHEN cs.status = 'ZERO_PB' THEN '0 PB'
    ELSE cs.status
  END AS status,
  cs.method,
  CONCAT('Status: ', 
    CASE 
      WHEN cs.status = 'ONE_PB'  THEN '1 PB'
      WHEN cs.status = 'ZERO_PB' THEN '0 PB'
      ELSE cs.status
    END
  ) AS status_label,

  CONCAT('Metode: ', COALESCE(cs.method, '')) AS method_label,

  cs.note,
  cs.pn,
  cs.pb,
  CONCAT('PN: ', COALESCE(cs.pn, '')) AS pn_label,
  CONCAT('PB: ', COALESCE(cs.pb, '')) AS pb_label,
  cs.num_of_cells,
  cs.frags_percentage,
   CASE cs.quality_score
    WHEN 1 THEN 'Poor'
    WHEN 2 THEN 'Moderate'
    WHEN 3 THEN 'Good'
    ELSE NULL
  END AS quality_score,
  COALESCE(cp.photo_file_paths, '') AS photo_file_paths
FROM cycle_samples cs
LEFT JOIN cycle_photos cp ON cp.sample_id = cs.sample_id
ORDER BY cs.sample_no;
]]></xml-property>
        </oda-data-set>
