                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">female_birth_dttm</property>
                    <property name="nativeName">birth_dttm</property>
                    <property name="dataType">date-time</property>
                    <property name="nativeDataType">93</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">female_age</property>
                    <property name="nativeName">female_age</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">-5</property>
                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">female_mrn</property>
                    <property name="nativeName">patient_mrn</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">11</property>
                    <property name="name">female_phone</property>
                    <property name="nativeName">person_telecom_value</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">12</property>
                    <property name="name">doctor_name</property>
                    <property name="nativeName">person_name</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
  oh.patient_couple_number,
  
  -- Data suami (male)
  male.person_name                               AS male_name,
  male.birth_dttm                                AS male_birth_dttm,
  TIMESTAMPDIFF(YEAR, male.birth_dttm, CURDATE()) AS male_age,
  pmale.patient_mrn                              AS male_mrn,
  mtelecom.person_telecom_value                  AS male_phone,
  
  -- Data istri (female)
  female.person_name                             AS female_name,
  female.birth_dttm                              AS female_birth_dttm,
  TIMESTAMPDIFF(YEAR, female.birth_dttm, CURDATE()) AS female_age,
  pfemale.patient_mrn                            AS female_mrn,
  ftelecom.person_telecom_value                  AS female_phone,
  
  -- Doctor
  doc.person_name                                AS doctor_name

FROM order_header oh
  JOIN patient_couple pc
    ON oh.order_type = 'couple'
   AND oh.patient_couple_number = pc.patient_cn

  LEFT JOIN person male
    ON pc.patient_couple_male_id = male.person_id
  LEFT JOIN patient pmale
    ON male.person_id = pmale.patient_id
  LEFT JOIN person_telecom mtelecom
    ON male.person_id = mtelecom.person_id
   AND mtelecom.person_telecom_system = 'phone'

  LEFT JOIN person female
    ON pc.patient_couple_female_id = female.person_id
  LEFT JOIN patient pfemale
    ON female.person_id = pfemale.patient_id
  LEFT JOIN person_telecom ftelecom
    ON female.person_id = ftelecom.person_id
   AND ftelecom.person_telecom_system = 'phone'

  LEFT JOIN person doc
    ON oh.dpjp_id = doc.person_id

WHERE
  oh.status_cd = 'normal'
  AND ? IN (
      pc.patient_couple_male_id,
      pc.patient_couple_female_id
  );
]]></xml-property>
