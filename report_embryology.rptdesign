                    <property name="nativeDataType">-5</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">sample_no</property>
                    <property name="nativeName">sample_no</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">cycle</property>
                    <property name="nativeName">cycle</property>
                    <property name="dataType">integer</property>
                    <property name="nativeDataType">4</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">day</property>
                    <property name="nativeName">day</property>
                    <property name="dataType">integer</property>
                    <property name="nativeDataType">4</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">ceser</property>
                    <property name="nativeName">person_name</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">checker</property>
                    <property name="nativeName">person_name</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">freezing_dttm</property>
                    <property name="nativeName">freezing_dttm</property>
                    <property name="dataType">date-time</property>
                    <property name="nativeDataType">93</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[WITH ranked_wo AS (
  SELECT 
    wo.work_order_id,
    wo.emr_id,
    wo.stimulant_item_id,
    ROW_NUMBER() OVER (
      ORDER BY wo.work_order_number ASC
    ) AS cycle_number
  FROM work_order wo
  JOIN emr e              ON wo.emr_id = e.emr_id
  JOIN encounter enc      ON e.encounter_id = enc.encounter_id
  JOIN order_header oh    ON enc.order_header_id = oh.order_header_id
  LEFT JOIN patient_couple pc  ON oh.patient_couple_number = pc.patient_cn
  LEFT JOIN person fmprs ON pc.patient_couple_female_id = fmprs.person_id
  LEFT JOIN patient fmpt ON fmprs.person_id             = fmpt.patient_id
  LEFT JOIN patient pa   ON e.patient_id = pa.patient_id
  WHERE ((oh.order_type = 'couple' AND fmpt.patient_id = ?) OR
         (oh.order_type <> 'couple' AND pa.patient_id   = ?))
    AND wo.stage_type = 0
),
selected_cycles AS (
  SELECT work_order_id, cycle_number
  FROM ranked_wo
  WHERE cycle_number BETWEEN ? AND ?
),
selected_procedures AS (
  SELECT ep.embryology_procedure_id, sc.cycle_number
  FROM embryology_procedure ep
  JOIN work_order wo 
    ON ep.emr_id = wo.emr_id AND ep.stimulant_item_id = wo.stimulant_item_id
  JOIN selected_cycles sc ON wo.work_order_id = sc.work_order_id
),
cycle_stage_headers AS (
  SELECT
    h.embryology_ivf_cycle_stage_header_id AS header_id,
    sp.cycle_number
  FROM embryology_ivf_cycle_stage_header h
  JOIN selected_procedures sp 
    ON h.embryology_procedure_id = sp.embryology_procedure_id
  WHERE h.stage_type = 10
),
cycle_samples AS (
  SELECT 
    s.embryology_ivf_cycle_stage_samples_id AS sample_id,
    s.no                                    AS sample_no,
    s.sample_type,
    s.cycle,
    s.day,
    s.ceser_id,
    s.checker_id,
    s.freezing_dttm,
    h.cycle_number
  FROM embryology_ivf_cycle_stage_samples s
  JOIN cycle_stage_headers h ON s.embryology_ivf_cycle_stage_header_id = h.header_id
)
SELECT
  cs.cycle_number,
  CONCAT('<center>', LPAD(IFNULL(cs.sample_no, '-'), 2, '0'), '</center>') AS sample_no,
  cs.cycle,
  cs.day,
  ceser.person_name   AS ceser,      
  checker.person_name AS checker,    
  cs.freezing_dttm
FROM cycle_samples cs
LEFT JOIN person ceser   ON cs.ceser_id     = ceser.person_id
LEFT JOIN person checker ON cs.checker_id = checker.person_id
ORDER BY cs.cycle_number, cs.sample_no;
]]></xml-property>
        </oda-data-set>
